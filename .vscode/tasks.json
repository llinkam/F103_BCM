{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "flash",
      "type": "shell",
      "command": "E:/Program/xpack-openocd-0.12.0-7/bin/openocd.exe",
      "args": [
        "-s",
        "E:/Program/xpack-openocd-0.12.0-7/openocd/scripts",
        "-f",
        "interface/stlink.cfg",
        "-f",
        "target/stm32f1x.cfg",
        "-c",
        "program build/Debug/F103_BCM.elf verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
